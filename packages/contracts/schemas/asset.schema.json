{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-agent.local/schemas/asset.schema.json",
  "title": "Asset",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "id",
    "schema_version",
    "revision",
    "status",
    "projectId",
    "kind",
    "name",
    "sourceType",
    "tags",
    "authorizationStatus",
    "updatedAt"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/uuid" },
    "schema_version": { "$ref": "#/$defs/schemaVersion" },
    "revision": { "$ref": "#/$defs/revision" },
    "status": { "$ref": "#/$defs/status" },
    "projectId": {
      "$ref": "https://video-agent.local/schemas/project.schema.json#/$defs/uuid"
    },
    "kind": {
      "type": "string",
      "enum": ["image", "video", "audio", "text", "document"]
    },
    "name": { "type": "string", "minLength": 1 },
    "sourceType": {
      "type": "string",
      "enum": [
        "user_upload",
        "provider_generated",
        "source_material",
        "imported"
      ]
    },
    "catalogRole": {
      "type": ["string", "null"],
      "enum": [
        "character",
        "location",
        "prop",
        "storyboard",
        "video_take",
        "dialogue",
        "music",
        "ambience",
        "effects",
        "other",
        null
      ]
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "authorizationStatus": {
      "type": "string",
      "enum": ["unknown", "declared", "verified", "restricted", "expired"]
    },
    "copyrightOwner": { "type": ["string", "null"], "minLength": 1 },
    "licenseLabel": { "type": ["string", "null"], "minLength": 1 },
    "licenseReference": { "type": ["string", "null"], "minLength": 1 },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "revision": { "type": "integer", "minimum": 0 },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generated",
        "pending_review",
        "approved",
        "rejected",
        "superseded",
        "archived"
      ]
    }
  }
}
