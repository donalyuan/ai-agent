{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-agent.local/schemas/media-inspection.schema.json",
  "title": "MediaInspection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "revision",
    "projectId",
    "assetVersionId",
    "assetVersionRevision",
    "sourceHash",
    "sourceFingerprint",
    "status",
    "metadata",
    "tool",
    "toolVersion",
    "operationKey",
    "retention",
    "license",
    "hold",
    "rawDiagnostic"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/uuid" },
    "schema_version": { "$ref": "#/$defs/schemaVersion" },
    "revision": { "type": "integer", "minimum": 1 },
    "projectId": { "$ref": "#/$defs/uuid" },
    "assetVersionId": { "$ref": "#/$defs/uuid" },
    "assetVersionRevision": { "type": "integer", "minimum": 0 },
    "sourceHash": { "$ref": "#/$defs/hash" },
    "sourceFingerprint": { "$ref": "#/$defs/hash" },
    "status": { "$ref": "#/$defs/status" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "tool": { "type": "string", "minLength": 1 },
    "toolVersion": { "type": "string", "minLength": 1 },
    "operationKey": { "type": "string", "minLength": 1 },
    "retention": { "$ref": "#/$defs/retention" },
    "license": { "$ref": "#/$defs/license" },
    "hold": { "type": "boolean" },
    "rawDiagnostic": { "type": ["string", "null"] }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": { "enum": ["pending", "ready", "failed", "stale"] },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mimeType",
        "sizeBytes",
        "checksum",
        "durationFrames",
        "timebase",
        "fpsNumerator",
        "fpsDenominator",
        "frameCount",
        "width",
        "height",
        "videoCodec",
        "pixelFormat",
        "audioTracks",
        "sampleRate",
        "channels"
      ],
      "properties": {
        "mimeType": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "checksum": { "$ref": "#/$defs/hash" },
        "durationFrames": { "type": "integer", "minimum": 0 },
        "timebase": { "type": "string", "minLength": 1 },
        "fpsNumerator": { "type": "integer", "minimum": 0 },
        "fpsDenominator": { "type": "integer", "minimum": 1 },
        "frameCount": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "videoCodec": { "type": "string", "minLength": 1 },
        "pixelFormat": { "type": "string", "minLength": 1 },
        "audioTracks": { "type": "integer", "minimum": 0 },
        "sampleRate": { "type": "integer", "minimum": 0 },
        "channels": { "type": "integer", "minimum": 0 }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "version"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "type": "string", "minLength": 1 } }
    }
  }
}
