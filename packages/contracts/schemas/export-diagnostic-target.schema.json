{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-agent.local/schemas/export-diagnostic-target.schema.json",
  "title": "ExportDiagnosticTarget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "targetType",
    "projectId",
    "episodeId",
    "timelineVersionId",
    "ownerId",
    "ownerRevision",
    "fieldPath",
    "routeToken",
    "code"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/uuid" },
    "schema_version": { "$ref": "#/$defs/schemaVersion" },
    "targetType": {
      "enum": [
        "timeline",
        "clip",
        "caption",
        "sound_cue",
        "asset_version",
        "renderer",
        "storage",
        "artifact"
      ]
    },
    "projectId": { "$ref": "#/$defs/uuid" },
    "episodeId": { "$ref": "#/$defs/uuid" },
    "timelineVersionId": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
    },
    "ownerId": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
    },
    "ownerRevision": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
    },
    "fieldPath": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9.]*$" }
      ]
    },
    "routeToken": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
    "code": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
