{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-agent.local/schemas/asset-version.schema.json",
  "title": "AssetVersion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "revision",
    "status",
    "projectId",
    "assetId",
    "versionNumber",
    "contentHash",
    "storageObject"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/uuid" },
    "schema_version": { "$ref": "#/$defs/schemaVersion" },
    "revision": { "$ref": "#/$defs/revision" },
    "status": { "$ref": "#/$defs/status" },
    "projectId": {
      "$ref": "https://video-agent.local/schemas/project.schema.json#/$defs/uuid"
    },
    "assetId": {
      "$ref": "https://video-agent.local/schemas/asset.schema.json#/$defs/uuid"
    },
    "versionNumber": { "type": "integer", "minimum": 1 },
    "contentHash": { "$ref": "#/$defs/hash" },
    "storageObject": { "$ref": "#/$defs/storageObject" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "revision": { "type": "integer", "minimum": 0 },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generated",
        "pending_review",
        "approved",
        "rejected",
        "superseded",
        "archived"
      ]
    },
    "hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "storageObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storageProvider",
        "bucket",
        "objectKey",
        "mimeType",
        "sizeBytes",
        "checksum"
      ],
      "properties": {
        "storageProvider": { "type": "string", "minLength": 1 },
        "bucket": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "objectKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\u0009-\\u000D\\u001C-\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000/])(?![\\s\\S]*[\\u0009-\\u000D\\u001C-\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]$(?![\\s\\S]))(?![A-Za-z][A-Za-z0-9+.-]*:)(?![^?#]*[?#])(?![^\\\\]*\\\\)(?!(?:[^/]+/)*\\.{1,2}(?:/|$))(?!(?:[^/]+/)*[\\u0009-\\u000D\\u001C-\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]+(?:/|$(?![\\s\\S])))(?:[^\\u0009-\\u000D\\u001C-\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000/](?:[^/]*[^\\u0009-\\u000D\\u001C-\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000/])?|[^\\u0009-\\u000D\\u001C-\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000/][^/]*/(?:[^/]+/)*[^/]*[^\\u0009-\\u000D\\u001C-\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000/])$"
        },
        "eTag": { "type": "string", "minLength": 1 },
        "checksum": { "$ref": "#/$defs/hash" },
        "mimeType": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "durationMs": { "type": "integer", "minimum": 0 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
