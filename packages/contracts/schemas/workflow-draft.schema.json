{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-agent.local/schemas/workflow-draft.schema.json",
  "title": "WorkflowDraft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "revision",
    "status",
    "projectId",
    "scopeType",
    "scopeIds",
    "definition"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/uuid" },
    "schema_version": { "$ref": "#/$defs/schemaVersion" },
    "revision": { "$ref": "#/$defs/revision" },
    "status": { "$ref": "#/$defs/status" },
    "projectId": {
      "$ref": "https://video-agent.local/schemas/project.schema.json#/$defs/uuid"
    },
    "scopeType": {
      "type": "string",
      "enum": ["project", "episode", "scene", "shot"]
    },
    "scopeIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uuid" }
    },
    "definition": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "revision": { "type": "integer", "minimum": 0 },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generated",
        "pending_review",
        "approved",
        "rejected",
        "superseded",
        "archived"
      ]
    }
  }
}
