{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-agent.local/schemas/shot.schema.json",
  "title": "Shot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "revision",
    "status",
    "projectId",
    "episodeId",
    "sceneId",
    "number"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/uuid" },
    "schema_version": { "$ref": "#/$defs/schemaVersion" },
    "revision": { "$ref": "#/$defs/revision" },
    "status": { "$ref": "#/$defs/status" },
    "projectId": {
      "$ref": "https://video-agent.local/schemas/project.schema.json#/$defs/uuid"
    },
    "episodeId": {
      "$ref": "https://video-agent.local/schemas/episode.schema.json#/$defs/uuid"
    },
    "sceneId": {
      "$ref": "https://video-agent.local/schemas/scene.schema.json#/$defs/uuid"
    },
    "number": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "revision": { "type": "integer", "minimum": 0 },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generated",
        "pending_review",
        "approved",
        "rejected",
        "superseded",
        "archived"
      ]
    }
  }
}
