# Local environment template for ai-agent.
# Copy to .env and fill real secrets locally.

VIDEO_AGENT_WORKSPACE_ROOT=/server/ai-agent

OPENAI_API_KEY=
OPENAI_BASE_URL=https://cy2api.cyrabbit.com:22222/responses
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=120
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=3000
