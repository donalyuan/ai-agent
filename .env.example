# Local environment template for ai-agent.
# Copy to .env and fill real secrets locally.

VIDEO_AGENT_WORKSPACE_ROOT=/server/ai-agent

OPENAI_API_KEY=
OPENAI_BASE_URL=https://cy2api.cyrabbit.com:22222/responses
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=120
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=3000

# Image generation is billable. Keep disabled until an operator explicitly enables it.
ASSET_GENERATION_WORKER_ENABLED=false
ASSET_GENERATION_POLL_SECONDS=5
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional dedicated base URL. When empty, a text /responses endpoint is normalized to the corresponding /v1 API root.
OPENAI_IMAGE_BASE_URL=
JIMENG_ACCESS_KEY=
JIMENG_SECRET_KEY=
JIMENG_REQ_KEY=high_aes_general_v30l_zt2i
JIMENG_IMAGE_WIDTH=1328
JIMENG_IMAGE_HEIGHT=1328
