# Local environment template for ai-agent.
# Model credentials below are read only by the explicit one-time import command.

VIDEO_AGENT_WORKSPACE_ROOT=/server/ai-agent

OPENAI_API_KEY=
OPENAI_BASE_URL=https://cy2api.cyrabbit.com:22222/responses
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=120
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=3000

# Image generation is billable. Keep disabled until an operator explicitly enables it.
ASSET_GENERATION_WORKER_ENABLED=false
VOICE_CATALOG_WORKER_ENABLED=false
SPEECH_GENERATION_WORKER_ENABLED=false
TOS_TOOL_WORKER_ENABLED=false
VOICE_CATALOG_POLL_SECONDS=5
SPEECH_GENERATION_POLL_SECONDS=5
SPEECH_WORKER_LEASE_SECONDS=600
ASSET_GENERATION_POLL_SECONDS=5
OPENAI_IMAGE_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_BASE_URL=
WORK_GENERATION_FAKE_PROVIDER_ENABLED=false
WORK_GENERATION_REAL_PROVIDER_ENABLED=false
WORK_GENERATION_WORKER_ENABLED=false
WORK_GENERATION_POLL_SECONDS=5
WORK_GENERATION_REAL_RUN_ALLOWLIST=
WORK_GENERATION_REAL_MAX_VIDEO_TASKS=1
WORK_GENERATION_REAL_MAX_VIDEO_SECONDS=15
WORK_GENERATION_REAL_MAX_TTS_CHARACTERS=398
WORK_GENERATION_REAL_MAX_ASR_TASKS=0
WORK_GENERATION_REAL_MAX_CONCURRENCY=1
WORK_GENERATION_REAL_SUBMIT_RETRIES=0
