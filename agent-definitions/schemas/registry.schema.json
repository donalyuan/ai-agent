{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novex.local/schemas/agent-definition-registry-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agents", "prompts", "context_policies", "tokenizer_profiles"],
  "properties": {
    "schema_version": { "const": "2" },
    "agents": { "type": "array", "items": { "$ref": "#/$defs/agent" } },
    "prompts": { "type": "array", "items": { "$ref": "#/$defs/prompt" } },
    "context_policies": { "type": "array", "items": { "$ref": "#/$defs/contextPolicy" } },
    "tokenizer_profiles": { "type": "array", "items": { "$ref": "#/$defs/tokenizerProfile" } }
  },
  "$defs": {
    "status": { "enum": ["candidate", "active", "supported", "revoked"] },
    "owner": { "enum": ["rust", "pi"] },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["key", "version"],
      "properties": { "key": { "type": "string", "minLength": 1 }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } }
    },
    "nodeReference": {
      "type": "object", "additionalProperties": false, "required": ["key", "version"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "context_policy": { "$ref": "#/$defs/reference" }
      }
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_key", "version", "status", "executor_owner", "role", "goals", "constraints", "model_requirements", "tool_profiles", "tools", "nodes"],
      "properties": {
        "agent_key": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "$ref": "#/$defs/status" }, "executor_owner": { "$ref": "#/$defs/owner" }, "role": { "type": "string", "minLength": 1 },
        "goals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "model_requirements": { "$ref": "#/$defs/modelRequirements" },
        "tool_profiles": { "type": "array", "uniqueItems": true, "items": { "enum": ["chat", "workspace"] } },
        "tools": { "type": "array", "uniqueItems": true, "items": { "enum": ["read", "write", "edit", "bash"] } },
        "nodes": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/nodeReference" } }
      }
    },
    "modelRequirements": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "tool_calling", "structured_output", "vision", "reasoning", "min_context_window"],
      "properties": {
        "text": { "type": "boolean" }, "tool_calling": { "type": "boolean" }, "structured_output": { "type": "boolean" },
        "vision": { "type": "boolean" }, "reasoning": { "type": "boolean" }, "min_context_window": { "type": "integer", "minimum": 1 }
      }
    },
    "prompt": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt_key", "version", "status", "executor_owner", "system_template", "user_template", "variables", "output_schema", "tool_profile", "max_output_tokens"],
      "properties": {
        "prompt_key": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "$ref": "#/$defs/status" }, "executor_owner": { "$ref": "#/$defs/owner" },
        "system_template": { "type": "string", "pattern": "^templates/(?:[a-z0-9._-]+/)*[a-z0-9._-]+\\.system\\.txt$" },
        "user_template": { "type": "string", "pattern": "^templates/(?:[a-z0-9._-]+/)*[a-z0-9._-]+\\.user\\.txt$" },
        "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } }, "output_schema": { "type": ["object", "null"] },
        "tool_profile": { "type": ["string", "null"], "enum": ["chat", "workspace", null] }, "max_output_tokens": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "variable": {
      "type": "object", "additionalProperties": false, "required": ["name", "value_type", "required", "trust", "max_bytes"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "value_type": { "enum": ["string", "string_list", "integer", "json", "fragments"] },
        "required": { "type": "boolean" }, "trust": { "enum": ["platform", "confirmed_fact", "reference", "user_instruction", "steer", "follow_up", "candidate"] },
        "max_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "contextPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_key", "version", "status", "executor_owners", "allowed_sources", "required_sources", "stable_sort"],
      "properties": {
        "policy_key": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "$ref": "#/$defs/status" }, "executor_owners": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/owner" } },
        "allowed_sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "required_sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "stable_sort": { "const": ["priority", "source_kind", "source_id", "source_version", "candidate_id"] }
      }
    },
    "tokenizerProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_key", "version", "status", "implementation_version", "mode", "applicable_protocols", "applicable_model_families", "framing", "safety_reserve_tokens"],
      "properties": {
        "profile_key": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "$ref": "#/$defs/status" }, "implementation_version": { "type": "string", "minLength": 1 },
        "mode": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["mode", "encoding", "asset_digest"], "properties": { "mode": { "const": "exact" }, "encoding": { "enum": ["cl100k_base", "o200k_base"] }, "asset_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
          { "type": "object", "additionalProperties": false, "required": ["mode", "algorithm"], "properties": { "mode": { "const": "conservative" }, "algorithm": { "const": "utf8-byte-upper-bound@1" } } }
        ] },
        "applicable_protocols": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["openai_responses", "openai_chat_completions"] } },
        "applicable_model_families": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "framing": { "type": "object", "additionalProperties": false, "required": ["per_message_tokens", "per_tool_tokens", "request_tokens", "reply_priming_tokens"], "properties": { "per_message_tokens": { "type": "integer", "minimum": 0 }, "per_tool_tokens": { "type": "integer", "minimum": 0 }, "request_tokens": { "type": "integer", "minimum": 0 }, "reply_priming_tokens": { "type": "integer", "minimum": 0 } } },
        "safety_reserve_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
