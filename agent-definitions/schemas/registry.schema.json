{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novex.local/schemas/agent-definition-registry-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agents", "prompts"],
  "properties": {
    "schema_version": { "const": "1" },
    "agents": { "type": "array", "items": { "$ref": "#/$defs/agent" } },
    "prompts": { "type": "array", "items": { "$ref": "#/$defs/prompt" } }
  },
  "$defs": {
    "status": { "enum": ["candidate", "active", "supported", "revoked"] },
    "owner": { "enum": ["rust", "pi"] },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_key", "version", "status", "executor_owner", "role", "goals", "constraints", "model_requirements", "tool_profiles", "tools", "nodes"],
      "properties": {
        "agent_key": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "$ref": "#/$defs/status" },
        "executor_owner": { "$ref": "#/$defs/owner" },
        "role": { "type": "string", "minLength": 1 },
        "goals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "model_requirements": { "$ref": "#/$defs/modelRequirements" },
        "tool_profiles": { "type": "array", "uniqueItems": true, "items": { "enum": ["chat", "workspace"] } },
        "tools": { "type": "array", "uniqueItems": true, "items": { "enum": ["read", "write", "edit", "bash"] } },
        "nodes": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/reference" } }
      }
    },
    "modelRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "tool_calling", "structured_output", "vision", "reasoning", "min_context_window"],
      "properties": {
        "text": { "type": "boolean" },
        "tool_calling": { "type": "boolean" },
        "structured_output": { "type": "boolean" },
        "vision": { "type": "boolean" },
        "reasoning": { "type": "boolean" },
        "min_context_window": { "type": "integer", "minimum": 1 }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_key", "version", "status", "executor_owner", "system_template", "user_template", "variables", "output_schema", "tool_profile", "max_output_tokens"],
      "properties": {
        "prompt_key": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "$ref": "#/$defs/status" },
        "executor_owner": { "$ref": "#/$defs/owner" },
        "system_template": { "type": "string", "pattern": "^templates/[a-z0-9._-]+\\.system\\.txt$" },
        "user_template": { "type": "string", "pattern": "^templates/[a-z0-9._-]+\\.user\\.txt$" },
        "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } },
        "output_schema": { "type": ["object", "null"] },
        "tool_profile": { "type": ["string", "null"], "enum": ["chat", "workspace", null] },
        "max_output_tokens": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value_type", "required", "trust", "max_bytes"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "value_type": { "enum": ["string", "string_list", "integer", "json", "fragments"] },
        "required": { "type": "boolean" },
        "trust": { "enum": ["platform", "confirmed_fact", "reference", "user_instruction", "steer", "follow_up", "candidate"] },
        "max_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
