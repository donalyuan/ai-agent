{
  "name": "novex-video-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next-dev && NEXT_DIST_DIR=.next-dev npm run dev:next",
    "dev:next": "next dev --hostname 0.0.0.0 --port ${PORT:-3000}",
    "build": "next build",
    "lint": "tsc --project tsconfig.lint.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "konva": "^9.3.22",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-konva": "^18.2.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.19.26",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  }
}
